{
  "name": "@heroku-cli/command",
  "description": "base class for Heroku CLI commands",
  "version": "13.2.3",
  "author": "Heroku",
  "bugs": {
    "url": "https://github.com/heroku/heroku-cli-command/issues"
  },
  "dependencies": {
    "@heroku/heroku-credential-manager": "0.1.0",
    "@heroku/http-call": "5.5.2",
    "@heroku/js-blanket": "^1.0.0",
    "@oclif/core": "^4.3.0",
    "@sentry/node": "^10.45.0",
    "ansis": "^4",
    "debug": "^4.4.0",
    "execa": "^9.6.1",
    "inquirer": "^12.11.1",
    "open": "^11.0.0",
    "tsheredoc": "^1.0.1",
    "yargs-parser": "^22.0.0",
    "yargs-unparser": "^2.0.0"
  },
  "devDependencies": {
    "@heroku-cli/schema": "^1.0.25",
    "@heroku-cli/test-utils": "^0.2.0",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "26.6.2",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^21.0.0",
    "@types/supports-color": "^5.3.0",
    "@types/yargs-parser": "^21.0.3",
    "@types/yargs-unparser": "^2.0.3",
    "@typescript-eslint/parser": "^8",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.1",
    "eslint": "^9",
    "eslint-config-oclif": "^6.0.152",
    "fancy-test": "^3.0.16",
    "fs-extra": "^11.3.0",
    "mocha": "^11",
    "nock": "^14.0.1",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.1",
    "stdout-stderr": "^0.1.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "lib"
  ],
  "homepage": "https://github.com/heroku/heroku-cli-command",
  "keywords": [
    "heroku"
  ],
  "license": "ISC",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroku/heroku-cli-command.git"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "mocha --forbid-only \"test/**/*.test.ts\" --ignore \"test/**/acceptance/**/*.test.ts\"",
    "test:watch": "mocha --watch \"test/**/*.test.ts\" --ignore \"test/**/acceptance/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --reporter=text-summary --reporter=lcovonly mocha --forbid-only \"test/**/*.test.ts\" --ignore \"test/**/acceptance/**/*.test.ts\"",
    "test:file": "c8 mocha",
    "test:ci:acceptance": "c8 mocha --forbid-only \"test/credential-manager/acceptance/index.acceptance.test.ts\"",
    "verify:packed-consumer": "node scripts/verify-packed-consumer.mjs",
    "verify:rollback": "node scripts/verify-credential-manager-rollback.mjs",
    "verify:rollback:guards": "node scripts/verify-credential-manager-rollback.mjs --self-test-guards",
    "verify:rollback:cleanup": "node scripts/verify-credential-manager-rollback.mjs --self-test-cleanup",
    "verify:trusted": "npm run verify:packed-consumer && npm run verify:rollback:guards && npm run verify:rollback:cleanup && npm run verify:rollback",
    "prepare": "npm run build",
    "example": "sh examples/run.sh"
  },
  "type": "module",
  "types": "./lib/index.d.ts",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "directories": {
    "example": "examples",
    "lib": "lib",
    "test": "test"
  }
}
